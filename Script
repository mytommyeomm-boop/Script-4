-- ============================================================
-- HELPERS
-- ============================================================
local function char()  return LP.Character end
local function hum()   local c=char(); return c and c:FindFirstChildOfClass("Humanoid") end
local function root()  local c=char(); return c and c:FindFirstChild("HumanoidRootPart") end

local function alive()
    local h = hum()
    return h ~= nil and h.Health > 0 and LP:GetAttribute("Alive") == true
end

local function blocked()
    if LP:GetAttribute("InTutorial")   then return true end
    if LP:GetAttribute("Transforming") then return true end
    local c = char()
    if c and c:GetAttribute("SelfRoot") then return true end
    local h = hum()
    if h and h:GetAttribute("Stunned") then return true end
    return false
end

-- ============================================================
-- ORB FINDER
-- ============================================================
local function getOrbsSorted(maxRange)
    local folder = workspace:FindFirstChild("Orbs")
    if not folder then return {} end
    local r = root(); if not r then return {} end

    local list = {}
    for _, o in folder:GetChildren() do
        if not o:IsA("BasePart") then continue end
        if o:GetAttribute("BurstFrom") then continue end
        local d = (o.Position - r.Position).Magnitude
        if d <= maxRange then
            table.insert(list, { orb = o, pos = o.Position, dist = d })
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

-- จัดกลุ่ม orb ที่อยู่ใกล้กัน
local function clusterOrbs(orbs, radius)
    local clusters, used = {}, {}
    for i = 1, #orbs do
        if used[i] then continue end
        used[i] = true
        local c = { center = orbs[i].pos, count = 1, orbs = { orbs[i].orb } }
        for j = i + 1, #orbs do
            if used[j] then continue end
            if (orbs[i].pos - orbs[j].pos).Magnitude <= radius then
                used[j] = true
                c.center = c.center + orbs[j].pos
                c.count  = c.count + 1
                table.insert(c.orbs, orbs[j].orb)
            end
        end
        c.center = c.center / c.count
        table.insert(clusters, c)
    end
    return clusters
end

-- ============================================================
-- MAGNET HITBOX (ขยายขอบเขตดูด orb)
-- ============================================================
local function setupMagnetPart()
    if State.MagnetPart and State.MagnetPart.Parent then
        State.MagnetPart:Destroy()
    end

    local c, r = char(), root()
    if not (c and r) then return end

    local part = Instance.new("Part")
    part.Name          = "MagnetHitbox"
    part.Size          = Vector3.new(State.HitboxSize, State.HitboxSize, State.HitboxSize)
    part.Transparency  = 1
    part.CanCollide    = false
    part.CanQuery      = false
    part.CanTouch      = true      -- สำคัญ! ให้ Touched ทำงาน
    part.Anchored      = true
    part.Massless      = true
    part.CFrame        = r.CFrame
    part.Parent        = c         -- เป็น descendant ของ character

    State.MagnetPart = part

    -- ให้ตาม player
    RunService.Heartbeat:Connect(function()
        if part.Parent and r.Parent then
            part.CFrame = r.CFrame
        end
    end)
end

local function updateMagnetPartSize()
    if State.MagnetPart and State.MagnetPart.Parent then
        State.MagnetPart.Size = Vector3.new(State.HitboxSize, State.HitboxSize, State.HitboxSize)
    end
end

local function removeMagnetPart()
    if State.MagnetPart and State.MagnetPart.Parent then
        State.MagnetPart:Destroy()
    end
    State.MagnetPart = nil
end

-- ============================================================
-- ACTIONS
-- ============================================================
local function doAttack(target)
    local now = os.clock()
    local aspd = (LP:GetAttribute("AttackSpeed") or 1) * (LP:GetAttribute("AttackSpeedMult") or 1)
    local cd = 1 / math.max(aspd, 0.1)
    if now - State.LastAttack < cd then return end
    State.LastAttack = now
    pcall(function() Remotes.Attack:FireServer(target) end)
end

local function doEvolve()
    if not State.AutoEvolve then return end
    if LP:GetAttribute("InVoidFight") then return end
    if LP:GetAttribute("AutoEvolveAt") then return end
    local spiderId = LP:GetAttribute("SpiderId") or ""
    local spider = SpiderDefs[spiderId]; if not spider then return end
    local stage  = LP:GetAttribute("Stage") or 1
    local level  = LP:GetAttribute("Level") or 1
    if Stages.Next(spider, stage, level) and os.clock() - State.LastEvolve > 1.5 then
        State.LastEvolve = os.clock()
        pcall(function() Remotes.Evolve:InvokeServer() end)
    end
end

local function doSprint()
    if not State.AutoSprint then return end
    if LP:GetAttribute("Exhausted") then return end
    if LP:GetAttribute("AlwaysSprint") then return end
    if os.clock() - State.LastSprint < 1 then return end
    State.LastSprint = os.clock()
    pcall(function() Remotes.SetSprint:FireServer(true) end)
end

local function canTarget(t)
    if not t or not t.Parent then return false end
    if t == char() then return false end
    if t:GetAttribute("OwnerId") == LP.UserId then return false end
    if t:GetAttribute("Boss") then return false end
    if t:GetAttribute("IsPlayer") then return false end
    local h = t:FindFirstChildOfClass("Humanoid")
    if h then
        if h.Health <= 0 then return false end
    elseif (t:GetAttribute("HP") or 0) <= 0 then
        return false
    end
    return true
end

local function findNearestBug(maxRange)
    local r = root(); if not r then return nil end
    local best, bestD = nil, maxRange
    for _, c in CollectionService:GetTagged("Creature") do
        if not c.Parent then continue end
        if c:GetAttribute("Kind") ~= "Bug" then continue end
        if c:GetAttribute("Corpse") then continue end
        if not canTarget(c) then continue end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if hrp then
            local d = (hrp.Position - r.Position).Magnitude
            if d < bestD then best, bestD = c, d end
        end
    end
    return best
end

-- ============================================================
-- MAGNET TICK
-- ============================================================
local function magnetTick()
    local r = root(); if not r then return end
    local orbs = getOrbsSorted(State.Range)

    if #orbs == 0 then
        State.Status = "no orbs"
        return
    end

    local target = orbs[1].pos
    local count  = 1

    if State.UseHitbox then
        -- cluster orb ในรัศมีครึ่งของ hitbox
        local clusters = clusterOrbs(orbs, State.HitboxSize * 0.4)
        if #clusters > 0 then
            table.sort(clusters, function(a, b)
                return (a.center - r.Position).Magnitude < (b.center - r.Position).Magnitude
            end)
            target = clusters[1].center
            count  = clusters[1].count
        end
    end

    r.CFrame = CFrame.new(target + Vector3.new(0, 5, 0))

    -- อัปเดต hitbox ทันที
    if State.MagnetPart and State.MagnetPart.Parent then
        State.MagnetPart.CFrame = r.CFrame
    end

    State.Status = string.format("magnet (%d orbs)", count)
end

-- ============================================================
-- WORKER LOOP
-- ============================================================
local function startWorker()
    if State.Running then return end
    State.Running = true

    task.spawn(function()
        while State.Enabled do
            if not alive() or blocked() then
                task.wait(0.25)
                continue
            end

            doSprint()
            doEvolve()

            pcall(magnetTick)

            if State.KillBugs then
                local bug = findNearestBug(50)
                if bug then
                    local hrp = bug:FindFirstChild("HumanoidRootPart")
                    if hrp and (hrp.Position - root().Position).Magnitude <= 5 then
                        doAttack(bug)
                    end
                end
            end

            task.wait(1 / math.max(State.Speed, 1))
        end
        State.Running = false
    end)
end

