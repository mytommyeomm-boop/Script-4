--// ====== KNOWLEDGE BASE ======
-- เก็บ keyword ที่บ่งบอกว่าเป็น steal animation
-- เพิ่มเติมได้เรื่อยๆ เมื่อเจอ animation ใหม่
local STEAL_KEYWORDS = {
    "steal", "stealing", "snatch", "tackle", "intercept",
    "strips", "stripping", "dispossess", "takeball", "take ball",
    "taketheball", "balltake", "ballsnatch", "predator", "ravenous",
    "shadowstrike", "silentsteal", "silent steal", "survivalinstinct",
    "predatory", "snatcher", "pickpocket", "larceny"
}

-- keyword ที่บอกว่าเป็นทักษะอื่น (เพื่อไม่ให้สับสน)
local OTHER_KEYWORDS = {
    tackle = { "tackle", "slide", "slidetackle", "slide tackle" },
    dribble = { "dribble", "dribbling", "feint", "stepover", "roulette" },
    shoot = { "shoot", "shot", "kick", "volley", "shotpower", "finisher" },
    skill   = { "skill", "technique", "special", "ult", "flow", "awaken" }
}

local function classify(track, animation, name, id)
    local lowerName = string.lower(name or "")
    local lowerId = string.lower(id or "")

    -- 1. เช็ค keyword steal ก่อน (ให้ความสำคัญสูงสุด)
    for _, kw in ipairs(STEAL_KEYWORDS) do
        if lowerName:find(kw, 1, true) or lowerId:find(kw, 1, true) then
            return "steal"
        end
    end

    -- 2. เช็ค keyword อื่น
    for category, keywords in pairs(OTHER_KEYWORDS) do
        for _, kw in ipairs(keywords) do
            if lowerName:find(kw, 1, true) then
                return category
            end
        end
    end

    -- 3. ถ้า priority เป็น Core = animation เดิน/วิ่ง/idle ของ Roblox
    local ok, priority = pcall(function()
        return track.Priority
    end)
    if ok and priority == Enum.AnimationPriority.Core then
        return "core"
    end

    -- 4. ค่าเริ่มต้น
    return "other"
end

