local function addUser(entry, player)
    if entry.userSet[player.UserId] then return end
    entry.userSet[player.UserId] = true
    table.insert(entry.users, player.DisplayName .. " (@" .. player.Name .. ")")
    entry.playersLabel.Text = "P (" .. #entry.users .. "): " ..
        table.concat(entry.users, ", ")
end

