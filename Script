    setMinimized(not minimized)
end)

--// Clipboard
local function copyText(value)
    local clipboard

    pcall(function()
        clipboard = setclipboard
    end)

    if typeof(clipboard) == "function" then
        local success = pcall(clipboard, value)

        if success then
            Status.Text = "Copied successfully!"
            return
        end
    end

    copyBoxActive = true
    CopyBox.Text = value
    CopyBox.Visible = not minimized
    Status.Text = "Select the text to copy manually"

    if not minimized then
        CopyBox:CaptureFocus()
        CopyBox.CursorPosition = #value + 1
        CopyBox.SelectionStart = 1
    end
end

