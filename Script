--// Mark as steal
local function markEntryAsSteal(entry, normalizedID)
    if entry.isSteal then return end
    entry.isSteal = true
    entry.category = "steal"
    learnedStealIDs[normalizedID] = { name = entry.name, markedAt = tick() }
    saveLearned()
    stealCount += 1
    updateStats()
    stealToast("(marked)", entry.name, entry.id)
    Status.Text = "Marked STEAL: " .. entry.name
    Status.TextColor3 = Color3.fromRGB(60, 255, 120)
    entry.row.BackgroundColor3 = Color3.fromRGB(18, 45, 28)
    entry.rowStroke.Color = Color3.fromRGB(60, 255, 120)
    entry.rowStroke.Thickness = 2
    entry.nameLabel.TextColor3 = Color3.fromRGB(120, 255, 160)
    if not entry.accent then
        local accent = Instance.new("Frame")
        accent.Size = UDim2.new(0, 3, 1, 0)
        accent.BackgroundColor3 = Color3.fromRGB(60, 255, 120)
        accent.BorderSizePixel = 0
        accent.Parent = entry.row
        Instance.new("UICorner", accent).CornerRadius = UDim.new(0, 8)
        entry.accent = accent
    end
    entry.markBtn.Text = "✓ STEAL"
    entry.markBtn.BackgroundColor3 = Color3.fromRGB(30, 130, 70)
    entry.row.LayoutOrder = -100000 - #entries
end

--// Detect (now records owner!)
local function detectAnimation(player, track)
    if not ScreenGui.Parent then return end
    if not player or not track then return end

    if not seenTracks[track] then
        seenTracks[track] = true
        totalPlays += 1
    end

    local animation
    pcall(function() animation = track.Animation end)
    if not animation then return end

    local id = animation.AnimationId
    if not id or id == "" then return end

    local normalizedID =
        id:match("[?&]id=(%d+)")
        or id:match("rbxassetid://(%d+)")
        or id:match("(%d+)$")
        or id

    local name = animation.Name
    if not name or name == "" or name == "Animation" then
        name = track.Name
    end
    if not name or name == "" or name == "Animation" then
        name = "Unnamed"
    end

    local category = classify(track, name, id, normalizedID)
    local isSteal = (category == "steal")
    local isMine = (player == LocalPlayer)

    if isSteal and not entryMap[normalizedID] then
        stealCount += 1
        stealToast(player.DisplayName, name, id)
        Status.Text = "🟢 STEAL: " .. name
        Status.TextColor3 = Color3.fromRGB(60, 255, 120)
        task.delay(3, function()
            if Status.Text:find("STEAL") then
                Status.Text = "Monitoring..."
                Status.TextColor3 = Color3.fromRGB(160, 175, 200)
            end
        end)
    end

    local existing = entryMap[normalizedID]
    if existing then
        existing.plays += 1
        addUser(existing, player)
        existing.info.Text = "ID: " .. existing.id ..
            " | P: " .. existing.plays ..
            " | " .. existing.category
        -- ถ้าเป็นของเราเอง และ entry เดิม owned by others
        if isMine and existing.owner ~= LocalPlayer then
            existing.owner = LocalPlayer
            existing.nameLabel.Text = (existing.isSteal and "🟢 " or "★ ") ..
                "MINE: " .. existing.name
        end
        applyFilter()
        return
    end

    -- สร้าง row ใหม่ (78px)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -3, 0, 78)
    row.BackgroundColor3 = isSteal
