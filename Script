    if stealCount > 0 then
        StealBadge.Visible = true
        StealText.Text = "STEAL x" .. stealCount
    else
        StealBadge.Visible = false
    end
end

--// Add player to entry
local function addUser(entry, player)
    if entry.userSet[player.UserId] then
        return
    end

    entry.userSet[player.UserId] = true

    table.insert(
        entry.users,
        player.DisplayName .. " (@" .. player.Name .. ")"
    )

    entry.playersLabel.Text =
        "Players (" .. #entry.users .. "): " ..
        table.concat(entry.users, ", ")
end

