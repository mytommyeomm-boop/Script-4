    Instance.new("UICorner", Copy).CornerRadius = UDim.new(0, 4)

    local entry = {
        id = id,
        name = name,
        plays = 1,
        category = category,
        isSteal = isSteal,
        owner = player,
        users = {},
        userSet = {},
        playersLabel = playersLabel,
        info = info,
        row = row,
        rowStroke = rowStroke,
        nameLabel = nameLabel,
        markBtn = markBtn,
        accent = nil,
        normalizedID = normalizedID,
    }

    if isSteal then
        local accent = Instance.new("Frame")
        accent.Size = UDim2.new(0, 3, 1, 0)
        accent.BackgroundColor3 = Color3.fromRGB(60, 255, 120)
        accent.BorderSizePixel = 0
        accent.Parent = row
        Instance.new("UICorner", accent).CornerRadius = UDim.new(0, 8)
        entry.accent = accent
    end

    entryMap[normalizedID] = entry
    table.insert(entries, entry)
    addUser(entry, player)

    Copy.MouseButton1Click:Connect(function()
        copyText(id)
    end)

    markBtn.MouseButton1Click:Connect(function()
        markEntryAsSteal(entry, normalizedID)
    end)

    updateStats()
    applyFilter()

    if isSteal then
        Status.Text = "🟢 New STEAL!"
        Status.TextColor3 = Color3.fromRGB(60, 255, 120)
    else
        Status.Text = isMine and "New MINE animation!" or "New animation!"
        Status.TextColor3 = isMine
            and Color3.fromRGB(255, 220, 120)
            or Color3.fromRGB(160, 175, 200)
    end
end

