local function setMinimized(value)
    minimized = value

    if minimized then
        Main.Size = UDim2.new(0.9, 0, 0, 52)
        Minimize.Text = "+"
    else
        Main.Size = ExpandedSize
        Minimize.Text = "−"
    end

    Status.Visible = not minimized
    CopyAll.Visible = not minimized
    List.Visible = not minimized
    Footer.Visible = not minimized
    CopyBox.Visible = copyBoxActive and not minimized
end

