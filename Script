--// Detect animation
local function detectAnimation(player, track)
    if not ScreenGui.Parent then return end
    if not player or not track then return end

    -- กันนับ Plays ซ้ำ (track เดียวกัน)
    local alreadyCounted = seenTracks[track]
    if not alreadyCounted then
        seenTracks[track] = true
        totalPlays += 1
    end

    local animation
    pcall(function()
        animation = track.Animation
    end)
    if not animation then return end

    local id = animation.AnimationId
    if not id or id == "" then return end

    local normalizedID =
        id:match("[?&]id=(%d+)")
        or id:match("rbxassetid://(%d+)")
        or id:match("(%d+)$")
        or id

    local name = animation.Name
    if not name or name == "" or name == "Animation" then
        name = track.Name
    end
    if not name or name == "" or name == "Animation" then
        name = "Unnamed Animation"
    end

    -- จำแนกประเภท
    local category = classify(track, animation, name, id)
    local isSteal = category == "steal"

    -- ถ้าเป็น steal และยังไม่เคยเจอ ID นี้ → แจ้งเตือนจุดเขียว
    if isSteal and not entryMap[normalizedID] then
        stealCount += 1
        stealToast(player.DisplayName, name, id)
        Status.Text = "⚠ STEAL DETECTED: " .. name
        Status.TextColor3 = Color3.fromRGB(60, 255, 120)
        task.delay(3, function()
            if Status.Text:find("STEAL") then
                Status.Text = "Monitoring players..."
                Status.TextColor3 = Color3.fromRGB(160, 175, 200)
            end
        end)
    end

    -- Same ID = same entry globally
    local existing = entryMap[normalizedID]

    if existing then
        existing.plays += 1
        addUser(existing, player)

        existing.info.Text =
            "ID: " .. existing.id ..
            " | Plays: " .. existing.plays ..
            " | " .. existing.category

        updateStats()
        return
    end

    -- New unique animation
    local row = Instance.new("Frame")
    row.Name = "AnimationEntry"
    row.Size = UDim2.new(1, -5, 0, 92)
    row.BackgroundColor3 = isSteal
        and Color3.fromRGB(18, 45, 28)   -- พื้นเขียวอ่อนสำหรับ steal
        or Color3.fromRGB(30, 36, 50)
    row.BorderSizePixel = 0
    -- steal ขึ้นบนสุดเสมอ
    row.LayoutOrder = isSteal and -100000 - #entries or -#entries - 1
    row.Parent = List

    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

    local rowStroke = Instance.new("UIStroke")
    rowStroke.Color = isSteal and Color3.fromRGB(60, 255, 120) or Color3.fromRGB(55, 67, 90)
    rowStroke.Thickness = isSteal and 2 or 1
    rowStroke.Parent = row

    -- แถบสีด้านซ้ายสำหรับ steal
    if isSteal then
        local accent = Instance.new("Frame")
        accent.Size = UDim2.new(0, 4, 1, 0)
        accent.BackgroundColor3 = Color3.fromRGB(60, 255, 120)
        accent.BorderSizePixel = 0
        accent.Parent = row
        Instance.new("UICorner", accent).CornerRadius = UDim.new(0, 8)
    end

    -- Animation name (พร้อมจุดเขียวถ้าเป็น steal)
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Position = UDim2.new(0, isSteal and 18 or 9, 0, 5)
    nameLabel.Size = UDim2.new(1, -105 - (isSteal and 9 or 0), 0, 19)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = (isSteal and "🟢 " or "") .. "Animation: " .. name
    nameLabel.TextColor3 = isSteal
        and Color3.fromRGB(120, 255, 160)
        or Color3.fromRGB(225, 235, 255)
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 11
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
    nameLabel.Parent = row

    -- Players
    local playersLabel = Instance.new("TextLabel")
    playersLabel.Position = UDim2.new(0, isSteal and 18 or 9, 0, 26)
    playersLabel.Size = UDim2.new(1, -105 - (isSteal and 9 or 0), 0, 24)
    playersLabel.BackgroundTransparency = 1
    playersLabel.TextColor3 = Color3.fromRGB(145, 165, 200)
    playersLabel.Font = Enum.Font.Gotham
    playersLabel.TextSize = 9
    playersLabel.TextXAlignment = Enum.TextXAlignment.Left
    playersLabel.TextYAlignment = Enum.TextYAlignment.Top
    playersLabel.TextWrapped = true
    playersLabel.Parent = row

    -- ID + Plays + Category
    local info = Instance.new("TextLabel")
    info.Position = UDim2.new(0, isSteal and 18 or 9, 0, 57)
    info.Size = UDim2.new(1, -105 - (isSteal and 9 or 0), 0, 25)
    info.BackgroundTransparency = 1
    info.Text = "ID: " .. id .. " | Plays: 1 | " .. category
    info.TextColor3 = Color3.fromRGB(145, 165, 200)
    info.Font = Enum.Font.Gotham
    info.TextSize = 9
    info.TextXAlignment = Enum.TextXAlignment.Left
    info.TextTruncate = Enum.TextTruncate.AtEnd
    info.Parent = row

    -- Copy ID
    local Copy = Instance.new("TextButton")
    Copy.Size = UDim2.fromOffset(78, 30)
    Copy.Position = UDim2.new(1, -87, 0.5, -15)
    Copy.BackgroundColor3 = isSteal
        and Color3.fromRGB(30, 130, 70)
        or Color3.fromRGB(50, 105, 175)
    Copy.Text = "COPY ID"
    Copy.TextColor3 = Color3.new(1, 1, 1)
    Copy.Font = Enum.Font.GothamBold
    Copy.TextSize = 10
    Copy.Parent = row

    Instance.new("UICorner", Copy).CornerRadius = UDim.new(0, 6)

    local entry = {
        id = id,
        name = name,
        plays = 1,
        category = category,
        isSteal = isSteal,
        users = {},
        userSet = {},
        playersLabel = playersLabel,
        info = info
    }

    entryMap[normalizedID] = entry
    table.insert(entries, entry)

    addUser(entry, player)

    Copy.MouseButton1Click:Connect(function()
        copyText(id)
    end)

    updateStats()

    if isSteal then
        Status.Text = "🟢 New STEAL animation detected!"
        Status.TextColor3 = Color3.fromRGB(60, 255, 120)
    else
        Status.Text = "New unique animation detected!"
        Status.TextColor3 = Color3.fromRGB(160, 175, 200)
    end
end

