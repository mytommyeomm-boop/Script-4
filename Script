local LP          = Players.LocalPlayer
local Remotes     = ReplicatedStorage:WaitForChild("Remotes")
local SpiderDefs  = require(ReplicatedStorage.Shared.SpiderDefs)
local Stages      = require(ReplicatedStorage.Shared.Stages)

-- ============================================================
-- STATE
-- ============================================================
local State = {
    Enabled       = false,
    Mode          = "Hybrid",       -- "Walk" | "Teleport" | "Hybrid"
    Range         = 400,
    TpThreshold   = 60,             -- Hybrid: ไกลกว่านี้วาป
    CollectOrbs   = true,
    KillBugs      = false,
    BreakObjects  = false,
    AutoAbility   = false,
    AutoEvolve    = false,
    AutoSprint    = false,
    Target        = nil,
    Kind          = nil,
    Status        = "idle",
    LastAttack    = 0,
    LastEvolve    = 0,
    StuckT        = 0,
    LastPos       = nil,
    NextJump      = 0,
}

-- ============================================================
-- HELPERS
-- ============================================================
local function char() return LP.Character end
local function hum()  local c=char(); return c and c:FindFirstChildOfClass("Humanoid") end
local function root() local c=char(); return c and c:FindFirstChild("HumanoidRootPart") end

local function alive()
    local h = hum()
    return h and h.Health > 0 and LP:GetAttribute("Alive") == true
end

local function blocked()
    if LP:GetAttribute("InTutorial")   then return true end
    if LP:GetAttribute("Transforming") then return true end
    local c = char()
    if c and c:GetAttribute("SelfRoot") then return true end
    local h = hum()
    if h and h:GetAttribute("Stunned") then return true end
    return false
end

local function stopMove()
    local h = hum(); if not h then return end
    local rp = h.RootPart
    if rp then h:MoveTo(rp.Position) end
end

local function walkTo(pos)
    local h = hum(); if not h then return end
    h:MoveTo(pos)
end

local function tpTo(pos)
    local r = root(); if not r then return end
    -- วาปทีละนิดกัน anti-cheat คร่าว ๆ
    r.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
end

-- ============================================================
-- FINDERS
-- ============================================================
local function findNearestOrb(maxRange)
    local folder = workspace:FindFirstChild("Orbs")
    if not folder then return nil end
    local r = root(); if not r then return nil end
    local best, bestD = nil, maxRange
    for _, o in folder:GetChildren() do
        if not o:IsA("BasePart") then continue end
        if o:GetAttribute("BurstFrom") then continue end   -- กำลังเล่นแอนิเมชัน
        local d = (o.Position - r.Position).Magnitude
        if d < bestD then
            best, bestD = o, d
        end
    end
    return best
end

local function canTarget(target)
    if not target or not target.Parent then return false end
    if target == char() then return false end
    if target:GetAttribute("OwnerId") == LP.UserId then return false end
    if target:GetAttribute("Boss") then return false end

    local h = target:FindFirstChildOfClass("Humanoid")
    if h then
        if h.Health <= 0 then return false end
    elseif (target:GetAttribute("HP") or 0) <= 0 then
        return false
    end

    if target:GetAttribute("IsPlayer") then return false end   -- ไม่ตีผู้เล่น
    return true
end

local function findNearestBug(maxRange)
    local r = root(); if not r then return nil end
    local best, bestD = nil, maxRange
    for _, c in CollectionService:GetTagged("Creature") do
        if not c.Parent then continue end
        if c:GetAttribute("Kind") ~= "Bug" then continue end
        if c:GetAttribute("Corpse") then continue end
        if not canTarget(c) then continue end
        local hrp = c:FindFirstChild("HumanoidRootPart"); if not hrp then continue end
        local d = (hrp.Position - r.Position).Magnitude
        if d < bestD then best, bestD = c, d end
    end
    return best
end

local function findNearestBreakable(maxRange)
    local r = root(); if not r then return nil end
    local best, bestD = nil, maxRange
    for _, o in CollectionService:GetTagged("Breakable") do
        if not o.Parent or not o.PrimaryPart then continue end
        if (o:GetAttribute("HP") or 0) <= 0 then continue end
        if o:GetAttribute("SpiderEgg") then continue end
        if o:GetAttribute("TutorialFor") then continue end
        if not canTarget(o) then continue end
        local d = (o.PrimaryPart.Position - r.Position).Magnitude
        if d < bestD then best, bestD = o, d end
    end
    return best
end

local function posOf(target)
    if not target or not target.Parent then return nil end
    if target:IsA("BasePart") then return target.Position end
    if target:IsA("Model") then
        local pr = target.PrimaryPart or target:FindFirstChild("HumanoidRootPart")
        return pr and pr.Position
    end
    return nil
end

-- ============================================================
-- ACTIONS
-- ============================================================
local function doAttack(target)
    local now = os.clock()
    local aspd = (LP:GetAttribute("AttackSpeed") or 1)
               * (LP:GetAttribute("AttackSpeedMult") or 1)
    local cd = 1 / math.max(aspd, 0.1)
    if now - State.LastAttack < cd then return end
    State.LastAttack = now
    Remotes.Attack:FireServer(target)
end

local function doAbilities(dist)
    if not State.AutoAbility then return end
    local slots = LP:GetAttribute("AbilitySlots") or 0
    if slots < 1 then return end
    local now = workspace:GetServerTimeNow()
    if slots >= 1 and dist > 8
       and now >= (LP:GetAttribute("Ability1Ready") or 0) + 0.3 then
        Remotes.UseAbility:FireServer(1)
    end
    if slots >= 2 and dist < 15
       and now >= (LP:GetAttribute("Ability2Ready") or 0) + 0.3 then
        Remotes.UseAbility:FireServer(2)
    end
end

local function doEvolve()
    if not State.AutoEvolve then return end
    if LP:GetAttribute("InVoidFight") then return end
    if LP:GetAttribute("AutoEvolveAt") then return end
    local spiderId = LP:GetAttribute("SpiderId") or ""
    local spider   = SpiderDefs[spiderId]; if not spider then return end
    local stage    = LP:GetAttribute("Stage") or 1
    local level    = LP:GetAttribute("Level") or 1
    if Stages.Next(spider, stage, level) then
        if os.clock() - State.LastEvolve > 1.5 then
            State.LastEvolve = os.clock()
            pcall(function() Remotes.Evolve:InvokeServer() end)
        end
    end
end

local function doSprint()
    if not State.AutoSprint then return end
    if LP:GetAttribute("AlwaysSprint") then return end
    if LP:GetAttribute("Exhausted") then return end
    if (LP:GetAttribute("Stamina") or 0) < 1 then return end
    Remotes.SetSprint:FireServer(true)
end

-- ============================================================
-- UPDATE LOOP
-- ============================================================
local function pickTarget()
    if State.CollectOrbs then
        local orb = findNearestOrb(State.Range)
        if orb then return orb, "Orb" end
    end
    if State.KillBugs then
        local bug = findNearestBug(State.Range)
        if bug then return bug, "Bug" end
    end
    if State.BreakObjects then
        local obj = findNearestBreakable(State.Range)
        if obj then return obj, "Breakable" end
    end
    return nil, nil
end

local function update(dt)
    if not State.Enabled then return end

    if not alive() or blocked() then
        stopMove()
        State.Status = "idle (dead/blocked)"
        return
    end

    doEvolve()
    doSprint()

    local r = root(); if not r then return end

    -- validate target
    local cur = State.Target
    local valid = false
    if cur and cur.Parent then
        if State.Kind == "Orb" then
            valid = not cur:GetAttribute("BurstFrom")
        else
            valid = canTarget(cur)
        end
    end

    if not valid then
        State.Target, State.Kind = pickTarget()
        cur = State.Target
    end

    if not cur then
        stopMove()
        State.Status = "no target"
        return
    end

    local tp = posOf(cur)
    if not tp then State.Target = nil; return end

    local dist = (tp - r.Position).Magnitude
    State.Status = string.format("%s (%.0f)", State.Kind, dist)

    if State.Kind == "Orb" then
        if State.Mode == "Teleport"
           or (State.Mode == "Hybrid" and dist > State.TpThreshold) then
            if dist > 3 then
                tpTo(tp)
            else
                walkTo(tp)
            end
        else
            walkTo(tp)
        end
    else
        if dist <= 4.5 then
            doAttack(cur)
            doAbilities(dist)
            stopMove()
        else
            walkTo(tp)
            doAbilities(dist)
        end
    end

    -- anti-stuck
    if State.LastPos then
        local moved = (r.Position - State.LastPos).Magnitude
        if moved < 0.5 then
            State.StuckT = State.StuckT + dt
            if State.StuckT > 1.5 and os.clock() > State.NextJump then
                local h = hum()
                if h then h.Jump = true end
                State.NextJump = os.clock() + 1.5
                State.StuckT = 0
            end
        else
            State.StuckT = 0
        end
    end
    State.LastPos = r.Position
end

RunService.Heartbeat:Connect(function(dt)
    local ok, err = pcall(update, dt)
    if not ok then warn("[AutoFarm] " .. tostring(err)) end
end)

LP.CharacterAdded:Connect(function()
    State.Target = nil
    State.LastPos = nil
end)

