--// Clipboard
local function copyText(value)
    local clipboard
    pcall(function() clipboard = setclipboard end)
    if typeof(clipboard) == "function" then
        if pcall(clipboard, value) then
            Status.Text = "Copied!"
            return
        end
    end
    copyBoxActive = true
    CopyBox.Text = value
    CopyBox.Visible = not minimized
    Status.Text = "Select text manually"
    if not minimized then
        CopyBox:CaptureFocus()
        CopyBox.CursorPosition = #value + 1
        CopyBox.SelectionStart = 1
    end
end

