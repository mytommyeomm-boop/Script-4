--// ====== CLASSIFY ======
local OTHER_KEYWORDS = {
    tackle  = { "tackle", "slide", "slidetackle" },
    dribble = { "dribble", "feint", "stepover", "roulette" },
    shoot   = { "shoot", "shot", "kick", "volley", "finisher" },
    skill   = { "skill", "special", "ult", "flow", "awaken" },
}

local function classify(track, name, id, normalizedID)
    if learnedStealIDs[normalizedID] or manualStealIDs[normalizedID] then
        return "steal"
    end
    local lowerName = string.lower(name or "")
    for category, kws in pairs(OTHER_KEYWORDS) do
        for _, kw in ipairs(kws) do
            if lowerName:find(kw, 1, true) then
                return category
            end
        end
    end
    local ok, priority = pcall(function() return track.Priority end)
    if ok and priority == Enum.AnimationPriority.Core then
        return "core"
    end
    return "other"
end

