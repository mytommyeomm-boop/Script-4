--// ====== PERSISTENCE ======
local SAVE_FILE = "AnimDetector_StealIDs.json"
local learnedStealIDs = {}
local manualStealIDs  = {}

local function hasFileAPI()
    return typeof(writefile) == "function" and typeof(isfile) == "function"
end

local function loadLearned()
    if not hasFileAPI() then return end
    local ok, data = pcall(function()
        if isfile(SAVE_FILE) then
            return HttpService:JSONDecode(readfile(SAVE_FILE))
        end
    end)
    if ok and typeof(data) == "table" then
        learnedStealIDs = data.learned or {}
        manualStealIDs  = data.manual  or {}
    end
end

local function saveLearned()
    if not hasFileAPI() then return end
    pcall(function()
        writefile(SAVE_FILE, HttpService:JSONEncode({
            learned = learnedStealIDs,
            manual  = manualStealIDs,
        }))
    end)
end

