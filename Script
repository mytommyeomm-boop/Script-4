--// Copy all
CopyAll.MouseButton1Click:Connect(function()
    if #entries == 0 then
        Status.Text = "Nothing to copy!"
        return
    end
    local steals, mine, others = {}, {}, {}
    for _, entry in ipairs(entries) do
        local block =
            "Animation: " .. entry.name ..
            "\nID: " .. entry.id ..
            "\nCategory: " .. entry.category ..
            "\nPlayers: " .. table.concat(entry.users, ", ") ..
            "\nPlays: " .. entry.plays
        if entry.isSteal then
            table.insert(steals, block)
        elseif entry.owner == LocalPlayer then
            table.insert(mine, block)
        else
            table.insert(others, block)
        end
    end
    local output = {}
    if #steals > 0 then
        table.insert(output, "=== STEAL (" .. #steals .. ") ===")
        table.insert(output, table.concat(steals, "\n\n"))
    end
    if #mine > 0 then
        table.insert(output, "=== MY ANIMATIONS (" .. #mine .. ") ===")
        table.insert(output, table.concat(mine, "\n\n"))
    end
    if #others > 0 then
        table.insert(output, "=== OTHERS (" .. #others .. ") ===")
        table.insert(output, table.concat(others, "\n\n"))
    end
    copyText(table.concat(output, "\n\n"))
end)

--// Watch
local function watchAnimator(animator, player)
    if monitored[animator] then return end
    monitored[animator] = true
    animator.AnimationPlayed:Connect(function(track)
        detectAnimation(player, track)
    end)
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        detectAnimation(player, track)
    end
end

local function watchCharacter(player, character)
    if not character then return end
    local function check(obj)
        if obj:IsA("Animator") then
            watchAnimator(obj, player)
        end
    end
    character.DescendantAdded:Connect(check)
    for _, obj in ipairs(character:GetDescendants()) do
        check(obj)
    end
end

local function watchPlayer(player)
    player.CharacterAdded:Connect(function(character)
        watchCharacter(player, character)
    end)
    if player.Character then
        watchCharacter(player, player.Character)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    watchPlayer(player)
end
Players.PlayerAdded:Connect(watchPlayer)

--// Draggable
local dragging = false
local dragStart, startPosition
Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = Main.Position
    end
end)
UIS.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

